# ─────────────────────────────────────────────────────────────────────────────
# Polar Stocks Terminal — variables de entorno de ejemplo
# ─────────────────────────────────────────────────────────────────────────────
#
# Copia este archivo a `.env` si necesitas alguna de estas variables.
# `.env` está en .gitignore y NUNCA debe versionarse.
#
# IMPORTANTE — dónde van de verdad las API keys
#
#   Las claves de los proveedores NO se configuran aquí. Se introducen desde la
#   propia aplicación, en Configuración → APIs, y se guardan cifradas con el
#   llavero del sistema operativo (DPAPI en Windows, Llavero en macOS, keyring
#   en Linux). Un archivo .env es texto plano en disco, sin cifrar y fácil de
#   filtrar en una copia de seguridad o al compartir una carpeta.
#
#   Las variables de abajo existen solo como referencia de qué proveedores
#   soporta el proyecto y para escenarios de desarrollo o CI donde interese
#   precargar credenciales de prueba.


# ─── Base de datos ───────────────────────────────────────────────────────────
#
# Solo la usa el CLI de Prisma en desarrollo (`prisma migrate dev`,
# `prisma studio`). La aplicación en ejecución NO lee esta variable: abre la
# base de datos de la carpeta de datos del usuario. Ver DATABASE_SETUP.md.
#
# Si no la defines, se usa `file:./prisma/dev.db`.
DATABASE_URL=


# ─── Proveedores de datos de mercado ─────────────────────────────────────────
#
# Ninguno es obligatorio. La aplicación arranca sin ninguno configurado y
# muestra en Configuración → APIs qué funciones quedan deshabilitadas.
# Se integran en la Fase 2.

# Acciones, ETFs, índices, noticias. Plan gratuito: 60 llamadas/minuto.
# https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Datos históricos y de mercado de alta calidad. Plan gratuito: 5 llamadas/minuto.
# https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Fundamentales, balances, resultados, dividendos.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Titulares generales de mercado y economía.
# https://newsapi.org/account
NEWS_API_KEY=

# Criptomonedas: precios, capitalización, dominancia, supply.
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Cripto en tiempo real por WebSocket.
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=


# ─── Panel Polar AI ──────────────────────────────────────────────────────────
#
# El panel de IA admite varios proveedores; el usuario elige cuál usar desde
# Configuración. Se integra en la Fase 4.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ─── Desarrollo ──────────────────────────────────────────────────────────────

# Pone el registro del proceso main en modo detallado.
# Valores: error | warn | info | verbose | debug | silly
POLAR_LOG_LEVEL=
